%% Voyago Use Case Diagram
%% Figure 3.2: Voyago Use Case Diagram

flowchart LR
    %% Primary Human Actors
    subgraph HumanActors["Human Actors"]
        direction TB
        User["fa:fa-user User<br/>(Authenticated Traveler)"]
        PublicViewer["fa:fa-globe Public Viewer<br/>(Unauthenticated Guest)"]
    end

    %% System Boundary
    subgraph SystemBoundary["Voyago Travel Planning System"]
        direction TB

        subgraph AuthUC["Authentication"]
            UC_Register(["Register Account"])
            UC_Login(["Login"])
            UC_Logout(["Logout"])
        end

        subgraph TripUC["Trip Management"]
            UC_CreateTrip(["Create Trip"])
            UC_ViewTrips(["View My Trips"])
            UC_SearchTrips(["Search Trips"])
            UC_FilterTrips(["Filter Trips"])
            UC_SortTrips(["Sort Trips"])
            UC_ViewTrip(["View Trip"])
            UC_UpdateTrip(["Update Trip"])
            UC_DeleteTrip(["Delete Trip"])
        end

        subgraph ItinUC["Itinerary"]
            UC_AddItin(["Add Itinerary Item"])
            UC_ViewItin(["View Itinerary"])
            UC_UpdateItin(["Update Itinerary Item"])
            UC_DeleteItin(["Delete Itinerary Item"])
        end

        subgraph IntelUC["Destination & Travel Intelligence"]
            UC_ResolveDest(["Resolve Destination"])
            UC_ViewWeather(["View Weather Forecast"])
            UC_DiscoverPlaces(["Discover Places"])
            UC_ViewPlaceInfo(["View Place Information"])
            UC_ViewPlacePhotos(["View Place Photos"])
            UC_ViewMap(["View Map"])
            UC_CalcRoute(["Calculate Driving Route"])
        end

        subgraph BudgetUC["Budget & Expenses"]
            UC_SetBudget(["Set Budget"])
            UC_ViewBudget(["View Budget"])
            UC_UpdateBudget(["Update Budget"])
            UC_DeleteBudget(["Delete Budget"])
            UC_AddExpense(["Add Expense"])
            UC_ViewExpenses(["View Expenses"])
            UC_UpdateExpense(["Update Expense"])
            UC_DeleteExpense(["Delete Expense"])
            UC_ViewBudgetAnalytics(["View Budget Analytics"])
        end

        subgraph PackingUC["Packing"]
            UC_AddPacking(["Add Packing Item"])
            UC_ViewPacking(["View Packing List"])
            UC_UpdatePacking(["Update Packing Item"])
            UC_TogglePacked(["Toggle Packed Status"])
            UC_DeletePacking(["Delete Packing Item"])
            UC_ViewPackingProgress(["View Packing Progress"])
        end

        subgraph NotifUC["Notifications"]
            UC_ViewNotif(["View Notifications"])
            UC_MarkRead(["Mark Notification as Read"])
            UC_MarkAllRead(["Mark All Notifications as Read"])
            UC_DeleteNotif(["Delete Notification"])
            UC_EvalNotif(["Evaluate / Generate Notifications"])
        end

        subgraph ShareUC["Trip Sharing"]
            UC_CreateShare(["Create Share Link"])
            UC_ViewShare(["View Share Link"])
            UC_RevokeShare(["Revoke Share Link"])
        end

        subgraph PrintUC["Print"]
            UC_ViewPrintTrip(["View Print-Friendly Trip"])
            UC_PrintPDF(["Print / Save as PDF"])
        end

        subgraph PublicViewUC["Public Trip Sharing (Read-Only)"]
            UC_OpenShared(["Open Shared Trip"])
            UC_ViewSharedTrip(["View Shared Trip Details"])
            UC_ViewSharedItin(["View Shared Itinerary"])
            UC_ViewSharedBudget(["View Shared Budget & Expenses"])
            UC_ViewSharedPacking(["View Shared Packing Information"])
        end

        %% Internal UML Include Relationships
        UC_ViewPrintTrip -. "<<include>>" .-> UC_PrintPDF
        UC_ViewNotif -. "<<include>>" .-> UC_EvalNotif

        UC_OpenShared -. "<<include>>" .-> UC_ViewSharedTrip
        UC_ViewSharedTrip -. "<<include>>" .-> UC_ViewSharedItin
        UC_ViewSharedTrip -. "<<include>>" .-> UC_ViewSharedBudget
        UC_ViewSharedTrip -. "<<include>>" .-> UC_ViewSharedPacking
    end

    %% External Systems / Supporting Actors
    subgraph ExternalSystems["External Supporting Services"]
        direction TB
        Ext_OpenMeteo["Open-Meteo<br/>(Geocoding & Forecast)"]
        Ext_Wikipedia["Wikipedia MediaWiki API<br/>(Landmark Extraction)"]
        Ext_Wikimedia["Wikimedia Commons API<br/>(Place Photos)"]
        Ext_OSRM["Project OSRM<br/>(Driving Route Calculation)"]
        Ext_OSM["OpenStreetMap Tile Service<br/>(Map Tiles)"]
    end

