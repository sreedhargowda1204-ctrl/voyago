# Voyago Backend Environment Variables Example
# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/voyago_db
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT Security Configuration
# JWT_SECRET must be a strong 256-bit (or higher) base64-encoded secret key in production
JWT_SECRET=your_base64_encoded_256bit_jwt_secret
JWT_EXPIRATION=86400000

# CORS & Frontend Origin Configuration (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# Optional: External Service Overrides
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# PLACES_WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
# MAPS_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# MAPS_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
